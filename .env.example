# Revenue Autopilot — environment template
# Copy to .env for local overrides. Never commit real secrets.

# SQLite for local development. Use a PostgreSQL URL on Render:
# DATABASE_URL=postgresql://user:pass@host:5432/revenue_autopilot
DATABASE_URL=sqlite:///./data/revenue_autopilot.db

# Optional LLM. The app works without this key (deterministic fallback).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Policy thresholds (INR)
HIGH_VALUE_THRESHOLD=50000
HIGH_RISK_THRESHOLD=0.75
LOW_CONFIDENCE_THRESHOLD=0.55
